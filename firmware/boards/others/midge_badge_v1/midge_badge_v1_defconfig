# Enable MPU
CONFIG_ARM_MPU=y

# enable GPIO
CONFIG_GPIO=y

# Enable RTT
CONFIG_USE_SEGGER_RTT=y

# disable uart driver
CONFIG_UART_CONSOLE=n

# enable console
CONFIG_RTT_CONSOLE=y

CONFIG_SENSOR=y
CONFIG_MCN_AUDIO_BUFFERS=5

# Debug cortex M
CONFIG_SEGGER_DEBUGMON=y
CONFIG_CORTEX_M_DEBUG_MONITOR_HOOK=y
# CONFIG_LOG_BACKEND_RTT_MODE_DROP=y #ENABLE IF MESSAGES CUT AND PLATFORM SEEMS TO FAULT
CONFIG_SEGGER_RTT_BUFFER_SIZE_UP=2048
