{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "firmware-guiconfig",
            "type": "shell",
            "command": "west build -p auto -b midge_badge_v1 application -t guiconfig",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            }
        },
        {
            "label": "pull-svd",
            "type": "shell",
            "command": "wget -O /tmp/nrf52832.svd https://raw.githubusercontent.com/embassy-rs/nrf-pac/refs/heads/main/svd/nrf52832.svd"
        },
        {
            "label": "build-firmware",
            "type": "shell",
            "command": "west build -p auto -b midge_badge_v1 application",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            }
            , "dependsOn" : [
                "pull-svd"
            ]
        },
        {
            "label": "flash-firmware",
            "type": "shell",
            "command": "west flash",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "dependsOn" : [
                "build-firmware"
            ]
        },
        {
            "label": "tester",
            "type": "shell",
            "command": "uv run tester"
        }
    ]
}
