{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "firmware-guiconfig",
            "type": "shell",
            "command": "west build -p auto -b ${input:board} application -t guiconfig",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            }
        },
        {
            "label": "build-firmware",
            "type": "shell",
            "command": "sh build.sh -b ${input:board}",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            }
        },
        {
            "label": "flash-firmware",
            "type": "shell",
            "command": "west flash",
            "options": {
                "cwd": "${workspaceFolder}/firmware"
            },
            "dependsOn" : [
                "build-firmware"
            ]
        },
        {
            "label": "tester",
            "type": "shell",
            "command": "uv run tester"
        }
    ],
    "inputs": [
        {
            "id": "board",
            "description": "board to build for",
            "type": "pickString",
            "options": [
                "midge_badge_v1",
                "midge_badge_v2"
            ],
            "default": "midge_badge_v1"
        }
    ]
}
